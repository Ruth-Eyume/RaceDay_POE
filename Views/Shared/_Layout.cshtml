<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDayMVC.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg raceday-navbar">
            <div class="container">

                <a class="navbar-brand raceday-brand"
                   asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">
                        <i class="bi bi-flag-fill"></i>
                    </span>
                    RaceDay
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>
                    </ul>

                    <div class="navbar-actions">

                        @if (Context.Session.GetString("UserAccountID") != null)
                        {
                            <span class="welcome-user">
                                Hello, @Context.Session.GetString("FirstName")
                            </span>

                            <a class="btn btn-outline-navy"
                               asp-controller="Account" asp-action="Logout">
                                Logout
                            </a>
                        }
                        else
                        {
                            <a class="login-link"
                               asp-controller="Account" asp-action="Login">
                                Log In
                            </a>

                            <a class="btn btn-navy"
                               asp-controller="Account" asp-action="Register">
                                Get Started
                            </a>
                        }

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="raceday-footer">
        <div class="container">
            <div class="row align-items-center gy-3">

                <div class="col-md-6">
                    <a class="footer-brand" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-flag-fill"></i> RaceDay
                    </a>
                    <p class="footer-tagline">
                        Every race. Every achievement. Every finish line.
                    </p>
                </div>

                <div class="col-md-6 text-md-end">
                    <p class="mb-0">
                        &copy; 2026 RaceDay. All rights reserved.
                    </p>
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>